      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, application) (rate(http_server_requests_seconds_bucket{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))",
