    {
      "type": "table",
      "title": "Эндпоинты за выбранный период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Средний RPS, ошибки 5xx и p95 по каждому эндпоинту. Кликни по заголовку колонки для сортировки.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__range]))"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\", status=~\"5..\"}[$__range]))"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true,
          "format": "table",
          "expr": "histogram_quantile(0.95, sum by (le, application, method, uri) (rate(http_server_requests_seconds_bucket{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "application": "Сервис",
              "method": "Метод",
              "uri": "Эндпоинт",
              "Value #A": "RPS",
              "Value #B": "5xx/с",
              "Value #C": "p95"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RPS"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx/с"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 3
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 0.0001
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "RPS",
            "desc": true
          }
        ]
      },
