{
  "uid": "rbs-overview",
  "title": "RBS — метрики сервисов",
  "tags": [
    "rbs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Выбери сервис и реплику сверху. Реплика = адрес ip:порт, под которым она зарегистрирована в Eureka.",
  "links": [
    {
      "title": "Метрики",
      "type": "link",
      "url": "/d/rbs-overview",
      "icon": "dashboard",
      "keepTime": true
    },
    {
      "title": "Логи",
      "type": "link",
      "url": "/d/rbs-logs",
      "icon": "doc",
      "keepTime": true
    },
    {
      "title": "Трейсы (Tempo)",
      "type": "link",
      "url": "/explore?schemaVersion=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceqlSearch%22%2C%22limit%22%3A20%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-1h%22%2C%22to%22%3A%22now%22%7D%7D%7D",
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Состояние",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Реплики",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\"}",
          "legendFormat": "{{application}} · {{instance}}"
        }
      ],
      "description": "Каждая плитка — одна реплика сервиса (адрес ip:порт). Красная — Prometheus не может снять с неё метрики.",
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Запросов в секунду",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "description": "Входящие HTTP-запросы выбранных сервисов/реплик (без /actuator).",
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Доля ошибок 5xx",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": ""
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 6,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Время ответа p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval])))",
          "legendFormat": ""
        }
      ],
      "description": "95% запросов быстрее этого значения.",
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Ошибок в логах за период",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(logback_events_total{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", level=\"error\"}[$__range]))",
          "legendFormat": ""
        }
      ],
      "description": "Сколько строк уровня ERROR записали выбранные сервисы за выбранный период. Сами строки — на дашборде «Логи».",
      "id": 6,
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 4
      }
    },
