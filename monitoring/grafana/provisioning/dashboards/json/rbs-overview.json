      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, instance) (rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{application}} · {{instance}}"
        }
      ],
      "description": "Если реплик несколько — видно, равномерно ли балансировщик делит нагрузку.",
