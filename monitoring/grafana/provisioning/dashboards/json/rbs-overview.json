    {
      "type": "timeseries",
      "title": "Heap, % от максимума",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1,
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application, instance) (jvm_memory_used_bytes{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", area=\"heap\"}) / sum by (application, instance) (jvm_memory_max_bytes{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", area=\"heap\"} > 0)",
          "legendFormat": "{{application}} · {{instance}}"
        }
      ],
      "description": "Пила — нормально (GC чистит). Плохо, если нижние точки пилы всё время растут: похоже на утечку.",
