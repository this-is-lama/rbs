          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"eureka-services\", application=~\"$application\", instance=~\"$instance\", uri!~\"/actuator.*\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
