          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": false,
            "text": "debug",
            "value": "debug"
          },
          {
            "selected": false,
            "text": "trace",
            "value": "trace"
          },
          {
            "selected": false,
            "text": "unknown",
            "value": "unknown"
          }
        ]
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Поиск (текст, traceId, regex)",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  }
